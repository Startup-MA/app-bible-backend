# Stage 1: Build
FROM node AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG REACT_APP_BACKEND_URL
ARG REACT_APP_PADDLE_INITIALIZE_TOKEN
ARG REACT_APP_NODE_ENV
ARG REACT_APP_PADDLE_ENVIRONMENT
ARG REACT_APP_GOOGLE_CLIENT_ID
ARG REACT_APP_GOOGLE_CLIENT_SECRET
ARG REACT_APP_APPLE_SERVICE_ID
ARG REACT_APP_SUPPORT_EMAIL
ARG REACT_APP_PREMIUM_PRODUCT_ID
ARG REACT_APP_FREE_TRIAL_MONTHLY_PRICE_ID
ARG REACT_APP_MONTHLY_PRICE_ID
ARG REACT_APP_YEARLY_PRICE_ID

ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_PADDLE_INITIALIZE_TOKEN=$REACT_APP_PADDLE_INITIALIZE_TOKEN
ENV REACT_APP_NODE_ENV=$REACT_APP_NODE_ENV
ENV REACT_APP_PADDLE_ENVIRONMENT=$REACT_APP_PADDLE_ENVIRONMENT
ENV REACT_APP_GOOGLE_CLIENT_ID=$REACT_APP_GOOGLE_CLIENT_ID
ENV REACT_APP_GOOGLE_CLIENT_SECRET=$REACT_APP_GOOGLE_CLIENT_SECRET
ENV REACT_APP_APPLE_SERVICE_ID=$REACT_APP_APPLE_SERVICE_ID
ENV REACT_APP_SUPPORT_EMAIL=$REACT_APP_SUPPORT_EMAIL
ENV REACT_APP_PREMIUM_PRODUCT_ID=$REACT_APP_PREMIUM_PRODUCT_ID
ENV REACT_APP_FREE_TRIAL_MONTHLY_PRICE_ID=$REACT_APP_FREE_TRIAL_MONTHLY_PRICE_ID
ENV REACT_APP_MONTHLY_PRICE_ID=$REACT_APP_MONTHLY_PRICE_ID
ENV REACT_APP_YEARLY_PRICE_ID=$REACT_APP_YEARLY_PRICE_ID

RUN npm run build

# Stage 2: Serve
FROM nginx:alpine
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 3001
CMD ["nginx", "-g", "daemon off;"]